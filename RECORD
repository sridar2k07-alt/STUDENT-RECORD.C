#include <stdio.h>

int main() {
    int id[100], mark[100];
    char name[100][50], department[100][30];
    int count = 0;
    int choice, searchId, i;

    while (1) {
        printf("\n===== STUDENT RECORD MANAGEMENT =====\n");
        printf("1. Add Student\n");
        printf("2. Display Students\n");
        printf("3. Search Student\n");
        printf("4. Update Student\n");
        printf("5. Delete Student\n");
        printf("6. Exit\n");

        printf("Enter your choice: ");
        scanf("%d", &choice);

        if (choice == 1) {
            printf("Enter Student ID: ");
            scanf("%d", &id[count]);

            printf("Enter Name: ");
            scanf(" %[^\n]", name[count]);

            printf("Enter Department: ");
            scanf(" %[^\n]", department[count]);

            printf("Enter Mark: ");
            scanf("%d", &mark[count]);

            count++;
            printf("Student added successfully!\n");
        }

        else if (choice == 2) {
            printf("\nID\tName\t\tDepartment\tMark\n");

            for (i = 0; i < count; i++) {
                printf("%d\t%s\t\t%s\t\t%d\n",
                       id[i], name[i], department[i], mark[i]);
            }
        }

        else if (choice == 3) {
            printf("Enter Student ID to search: ");
            scanf("%d", &searchId);

            for (i = 0; i < count; i++) {
                if (id[i] == searchId) {
                    printf("ID: %d\n", id[i]);
                    printf("Name: %s\n", name[i]);
                    printf("Department: %s\n", department[i]);
                    printf("Mark: %d\n", mark[i]);
                    break;
                }
            }

            if (i == count)
                printf("Student not found!\n");
        }

        else if (choice == 4) {
            printf("Enter Student ID to update: ");
            scanf("%d", &searchId);

            for (i = 0; i < count; i++) {
                if (id[i] == searchId) {
                    printf("Enter new Mark: ");
                    scanf("%d", &mark[i]);

                    printf("Student updated successfully!\n");
                    break;
                }
            }

            if (i == count)
                printf("Student not found!\n");
        }

        else if (choice == 5) {
            printf("Enter Student ID to delete: ");
            scanf("%d", &searchId);

            for (i = 0; i < count; i++) {
                if (id[i] == searchId) {
                    for (int j = i; j < count - 1; j++) {
                        id[j] = id[j + 1];
                        mark[j] = mark[j + 1];

                        for (int k = 0; k < 50; k++)
                            name[j][k] = name[j + 1][k];

                        for (int k = 0; k < 30; k++)
                            department[j][k] = department[j + 1][k];
                    }

                    count--;
                    printf("Student deleted successfully!\n");
                    break;
                }
            }

            if (i == count)
                printf("Student not found!\n");
        }

        else if (choice == 6) {
            printf("Thank you!\n");
            break;
        }

        else {
            printf("Invalid choice!\n");
        }
    }

    return 0;
}
